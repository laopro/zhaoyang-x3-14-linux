#!/bin/bash
# systemd-sleep hook: measures battery drain and S0ix residency per suspend.
# Part of: zhaoyang-x3-14-linux
#
# Logs one line per suspend to /var/log/s0ix-drain.log:
#   <timestamp>  slept=<h>  drain=<Wh>  avg=<W>  %/h=<pct>  S0ix=<pct>
#
# Hardware-agnostic: battery and capacity are read at runtime, nothing is
# hardcoded. Works on any laptop, but only reports S0ix on Intel platforms
# that expose the low_power_idle counters.

BAT=""
for b in /sys/class/power_supply/BAT*; do
    [ -r "$b/energy_now" ] && [ -r "$b/energy_full" ] && BAT="$b" && break
done
R_SYS=/sys/devices/system/cpu/cpuidle/low_power_idle_system_residency_us
STATE=/run/s0ix-drain.state
LOG=/var/log/s0ix-drain.log

[ -n "$BAT" ] || exit 0

read_res() { [ -r "$R_SYS" ] && cat "$R_SYS" || echo 0; }

case "$1/$2" in
  pre/suspend|pre/suspend-then-hibernate|pre/hybrid-sleep)
      echo "$(date +%s) $(cat "$BAT/energy_now") $(read_res)" > "$STATE"
      ;;
  post/suspend|post/suspend-then-hibernate|post/hybrid-sleep)
      [ -r "$STATE" ] || exit 0
      read -r t0 e0 r0 < "$STATE"
      t1=$(date +%s); e1=$(cat "$BAT/energy_now"); r1=$(read_res)
      full=$(cat "$BAT/energy_full")
      awk -v t0="$t0" -v t1="$t1" -v e0="$e0" -v e1="$e1" \
          -v r0="$r0" -v r1="$r1" -v full="$full" '
      BEGIN {
          dt = t1 - t0
          if (dt <= 0 || full <= 0) exit
          wh   = (e0 - e1) / 1e6
          hrs  = dt / 3600
          w    = wh / hrs
          pct  = w / (full / 1e6) * 100
          s0ix = (r1 > r0) ? (r1 - r0) / 1e6 / dt * 100 : 0
          printf "%s  slept=%.2f h  drain=%.3f Wh  avg=%.3f W  %%/h=%.2f  S0ix=%.1f%%\n",
                 strftime("%Y-%m-%d %H:%M:%S", t1), hrs, wh, w, pct, s0ix
      }' >> "$LOG"
      rm -f "$STATE"
      ;;
esac
exit 0
